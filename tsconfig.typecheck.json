{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "types": ["bun", "react"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["packages/**/dist/**", "packages/**/type-tests/**"]
}
