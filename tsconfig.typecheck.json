{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "paths": {
      "@rusl-labs/surface": ["./packages/core/src/index.ts"],
      "@rusl-labs/surface-html": ["./packages/html/src/index.tsx"],
      "@rusl-labs/surface-ajv": ["./packages/ajv/src/index.ts"]
    },
    "declaration": false,
    "noEmit": true,
    "types": ["bun", "react"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["packages/**/dist/**", "packages/**/type-tests/**"]
}
