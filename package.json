{
  "name": "@rusl-labs/surface-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun x tsc -b --force",
    "typecheck": "bun x tsc -p tsconfig.typecheck.json --pretty false && bun x tsc -p packages/html/tsconfig.type-tests.json --pretty false",
    "test": "bun test",
    "check:file-size": "bun scripts/check-authored-file-size.ts",
    "check": "bun run check:file-size && bun run typecheck && bun run test && bun run build",
    "playground": "bun examples/playground/index.html --port=${PORT:-3000}"
  },
  "dependencies": {
    "@rusl-labs/surface": "workspace:*",
    "@rusl-labs/surface-ajv": "workspace:*",
    "@rusl-labs/surface-html": "workspace:*",
    "libphonenumber-js": "^1.13.10"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "latest",
    "@types/react": "latest",
    "@types/react-dom": "^19.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "currency.js": "2.0.4",
    "happy-dom": "^20.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "latest"
  }
}
