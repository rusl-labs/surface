{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.rusl.com/resources/rusl/schemas/surface.annotation",
  "title": "Surface annotation document",
  "description": "Presentation for one subject schema. No components, no code, no constraints.",
  "type": "object",
  "required": ["subject"],
  "anyOf": [{ "required": ["views"] }, { "required": ["defs"] }],
  "additionalProperties": false,
  "properties": {
    "$kind": { "const": "https://resources.rusl.com/resources/rusl/schemas/surface.annotation" },
    "subject": {
      "type": "string",
      "minLength": 1,
      "description": "The target schema's $id."
    },
    "targetLibraries": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Kit identifiers this annotation targets. Metadata for tooling only; core ignores this field."
    },
    "views": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/view" },
      "description": "Named views. default is the fallback."
    },
    "defs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": {
        "type": "object",
        "required": ["views"],
        "additionalProperties": false,
        "properties": {
          "views": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/view" }
          }
        }
      },
      "description": "Per-def view blocks. defs.<name> targets #/$defs/<name> at every use site."
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "layout": { "$ref": "#/$defs/fieldLayout" },
        "direction": { "$ref": "#/$defs/fieldDirection" },
        "fields": { "$ref": "#/$defs/fieldList" },
        "rest": { "$ref": "#/$defs/rest" }
      }
    },
    "fieldLayout": {
      "type": "string",
      "enum": ["props", "stack"],
      "description": "Field chrome style. props: label next to value (default). stack: full-width blocks."
    },
    "fieldDirection": {
      "type": "string",
      "enum": ["vertical", "horizontal"],
      "description": "Body flow. vertical: column (default). horizontal: wrapping row."
    },
    "fieldList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" },
      "contains": { "$ref": "#/$defs/restSlot" },
      "minContains": 0,
      "maxContains": 1
    },
    "entry": {
      "oneOf": [
        { "$ref": "#/$defs/boundEntry" },
        { "$ref": "#/$defs/sectionEntry" },
        { "$ref": "#/$defs/templateEntry" },
        { "$ref": "#/$defs/blockEntry" },
        { "$ref": "#/$defs/bannerEntry" },
        { "$ref": "#/$defs/spanEntry" },
        { "$ref": "#/$defs/restSlot" }
      ]
    },
    "blockEntry": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "Structural block chrome.",
      "properties": {
        "kind": { "const": "block" },
        "label": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "layout": { "$ref": "#/$defs/fieldLayout" },
        "direction": { "$ref": "#/$defs/fieldDirection" },
        "omit": { "type": ["boolean", "null"] },
        "fields": { "$ref": "#/$defs/fieldList" },
        "template": {
          "type": "string",
          "description": "Interpolated text inside the chrome. Same rules as templateEntry."
        },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "bannerEntry": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "Full-bleed banner chrome.",
      "properties": {
        "kind": { "const": "banner" },
        "label": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "layout": { "$ref": "#/$defs/fieldLayout" },
        "direction": { "$ref": "#/$defs/fieldDirection" },
        "omit": { "type": ["boolean", "null"] },
        "fields": { "$ref": "#/$defs/fieldList" },
        "template": { "type": "string" },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "spanEntry": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "description": "Inline chrome for short prose or nested fields.",
      "properties": {
        "kind": { "const": "span" },
        "label": { "type": ["string", "null"] },
        "omit": { "type": ["boolean", "null"] },
        "fields": { "$ref": "#/$defs/fieldList" },
        "template": { "type": "string" },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "boundEntry": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "A single property name on the containing object. Never dotted. Nest with fields."
        },
        "label": { "type": ["string", "null"], "description": "null clears a key inherited from the default view or a ref target." },
        "description": { "type": ["string", "null"] },
        "hidden": { "type": ["boolean", "null"], "description": "Not shown but still submits with the form." },
        "omit": { "type": ["boolean", "null"], "description": "Not part of the presentation at all." },
        "view": { "type": ["string", "null"], "description": "View for the child Surface. Flows to descendants." },
        "itemLabel": { "type": ["string", "null"], "description": "Singular noun for array item controls (add, remove, empty state)." },
        "addLabel": {
          "type": ["string", "null"],
          "description": "Label on the add button. Omit for icon-only. {{path}} interpolates over this node's data."
        },
        "items": {
          "$ref": "#/$defs/itemEntry",
          "description": "Describes inline array items. For $ref items, annotate the target schema instead; fields is ignored here."
        },
        "widget": { "oneOf": [{ "$ref": "#/$defs/widget" }, { "type": "null" }] },
        "fields": { "$ref": "#/$defs/fieldList", "description": "Nested object layout. Ignored when the entry is a $ref." },
        "rest": { "$ref": "#/$defs/rest" },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "itemEntry": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "view": { "type": "string", "minLength": 1 },
        "widget": { "$ref": "#/$defs/widget" },
        "fields": { "$ref": "#/$defs/fieldList" },
        "rest": { "$ref": "#/$defs/rest" },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "sectionEntry": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "Section heading. Empty string for an anonymous group with no heading."
        },
        "description": { "type": ["string", "null"] },
        "layout": { "$ref": "#/$defs/fieldLayout" },
        "direction": { "$ref": "#/$defs/fieldDirection" },
        "omit": { "type": ["boolean", "null"] },
        "widget": { "$ref": "#/$defs/widget", "description": "Kit treatment for the group. Unknown treatments degrade to a plain section." },
        "fields": { "$ref": "#/$defs/fieldList", "description": "Omit for a heading-only section. A section with no visible children is hidden." },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "templateEntry": {
      "type": "object",
      "required": ["template"],
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "description": "Interpolated text. Dotted keys allowed ({{actor.name}}). Always HTML-escaped. Missing keys render empty."
        },
        "label": { "type": ["string", "null"] },
        "omit": { "type": ["boolean", "null"] },
        "input": { "$ref": "#/$defs/modeOverride" },
        "display": { "$ref": "#/$defs/modeOverride" }
      }
    },
    "restSlot": {
      "type": "object",
      "required": ["rest"],
      "additionalProperties": false,
      "properties": {
        "rest": { "const": true, "description": "Where unlisted properties appear. Absent: after listed fields. At most one per field list." }
      }
    },
    "modeOverride": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Per-mode overrides for decoration keys. Layout (fields, rest, items) stays per-view. null clears an inherited value.",
      "properties": {
        "label": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "hidden": { "type": ["boolean", "null"] },
        "omit": { "type": ["boolean", "null"] },
        "view": { "type": ["string", "null"] },
        "itemLabel": { "type": ["string", "null"] },
        "addLabel": { "type": ["string", "null"] },
        "widget": { "oneOf": [{ "$ref": "#/$defs/widget" }, { "type": "null" }] }
      }
    },
    "widget": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "description": "Widget selection. When $kind is set, the entire widget value must conform to that kit schema's def. Without $kind, the renderer owned by name interprets the properties. Core does not validate $kind.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Short widget name; candidate key `widget:<name>` (fallback after `$kind`)."
        },
        "$kind": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute URI of the kit def this widget conforms to. Takes precedence over name in renderer resolution."
        },
        "options": {
          "type": "object",
          "additionalProperties": true,
          "description": "Nested renderer params. Top-level properties on widget are also allowed; both are open."
        }
      }
    },
    "rest": {
      "enum": ["append", "omit"],
      "description": "append: unlisted properties shown in schema order (default). omit: hidden."
    }
  }
}
