{
  "name": "@rusl-labs/surface",
  "version": "0.1.0",
  "description": "Validator-agnostic recursive React runtime for JSON Schema forms and displays.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "browser": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  }
}
