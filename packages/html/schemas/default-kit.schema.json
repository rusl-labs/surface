{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit",
  "title": "Surface default HTML kit — widget vocabulary",
  "description": "Widget vocabulary for the default HTML kit. Each $defs entry defines the shape of a widget object when $kind points at it.",
  "version": "0.1.0",
  "$defs": {
    "optionExpr": {
      "title": "Option expression",
      "description": "A value path, a {{template}}, or a fixed literal. String shorthand: dotted path if no braces, template if {{…}} present, literal otherwise.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Shorthand path, template, or literal (see description)."
        },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Dotted path on this node's data."
            }
          }
        },
        {
          "type": "object",
          "required": ["template"],
          "additionalProperties": false,
          "properties": {
            "template": {
              "type": "string",
              "description": "`{{a.b}}` interpolation over record data."
            }
          }
        },
        {
          "type": "object",
          "required": ["literal"],
          "additionalProperties": false,
          "properties": {
            "literal": { "type": "string" }
          }
        }
      ]
    },
    "input": {
      "title": "Native input widget",
      "description": "Generic text input. Extra properties pass through as HTML attributes.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/input"
        },
        "options": { "type": "object", "additionalProperties": true },
        "type": {
          "type": "string",
          "description": "HTML input type: text, password, email, search, tel, url, etc."
        },
        "placeholder": { "type": "string" },
        "autocomplete": { "type": "string" }
      }
    },
    "date": {
      "title": "Date widget",
      "description": "Calendar date without time. Input: HTML date. Display: plain text.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/date"
        },
        "options": { "type": "object", "additionalProperties": true },
        "min": { "$ref": "#/$defs/optionExpr" },
        "max": { "$ref": "#/$defs/optionExpr" }
      }
    },
    "datetime": {
      "title": "Date-time widget",
      "description": "Date and time. Wire format: RFC 3339. Input: datetime-local. Display: formatted instant.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/datetime"
        },
        "options": { "type": "object", "additionalProperties": true },
        "showSeconds": { "type": "boolean" },
        "min": { "$ref": "#/$defs/optionExpr" },
        "max": { "$ref": "#/$defs/optionExpr" }
      }
    },
    "media": {
      "title": "Media widget",
      "description": "Image, video, or audio from a URL or array of assets.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/media"
        },
        "options": { "type": "object", "additionalProperties": true },
        "src": { "$ref": "#/$defs/optionExpr" },
        "alt": { "$ref": "#/$defs/optionExpr" },
        "maxHeight": { "type": "number" },
        "maxItems": { "type": "integer", "minimum": 0 },
        "fit": { "type": "string", "enum": ["cover", "contain"] },
        "autoplay": { "type": "boolean" },
        "controls": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "loop": { "type": "boolean" },
        "layout": {
          "type": "string",
          "enum": ["inline", "banner", "full", "hero"],
          "description": "banner, full, hero: full-width (hides the property label). inline: normal flow."
        },
        "fullWidth": {
          "type": "boolean",
          "description": "Shortcut for layout: banner."
        }
      }
    },
    "link": {
      "title": "Link widget",
      "description": "Anchor link. Text falls back to href. Accepts a single URL, an object, or an array.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/link"
        },
        "options": { "type": "object", "additionalProperties": true },
        "href": { "$ref": "#/$defs/optionExpr" },
        "text": { "$ref": "#/$defs/optionExpr" },
        "label": {
          "$ref": "#/$defs/optionExpr",
          "description": "Alias for text."
        },
        "target": { "type": "string" },
        "rel": { "type": "string" },
        "external": { "type": "boolean" }
      }
    },
    "email": {
      "title": "Email widget",
      "description": "Email address. Input: HTML email. Display: mailto link.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/email"
        },
        "options": { "type": "object", "additionalProperties": true },
        "placeholder": { "type": "string" },
        "autocomplete": { "type": "string" }
      }
    },
    "tel": {
      "title": "Telephone widget",
      "description": "Phone number. Wire format: E.164. Input: HTML tel. Display: formatted number with tel: link.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/tel"
        },
        "options": { "type": "object", "additionalProperties": true },
        "defaultCountry": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "ISO 3166-1 alpha-2 code for flag picker and number parsing. Overrides the kit default."
        },
        "countries": {
          "type": "array",
          "description": "Restrict the flag picker to these ISO 3166-1 alpha-2 codes. Omit for all countries.",
          "items": { "type": "string", "minLength": 2, "maxLength": 2 }
        },
        "showCountry": {
          "type": "boolean",
          "description": "Show the flag and country typeahead. Default true."
        },
        "placeholder": { "type": "string" },
        "autocomplete": { "type": "string" }
      }
    },
    "copy": {
      "title": "Copy widget",
      "description": "Read-only value with a copy-to-clipboard button.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/copy"
        },
        "options": { "type": "object", "additionalProperties": true },
        "buttonLabel": {
          "type": "string",
          "description": "Button label. Default: Copy."
        }
      }
    },
    "table": {
      "title": "Table widget",
      "description": "Display-only table of an array of objects. Sort reorders display only; wire order stays index order. Put this widget on the array field.",
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "$kind": {
          "type": "string",
          "const": "https://resources.rusl.com/resources/rusl/schemas/surface.default-kit#/$defs/table"
        },
        "options": { "type": "object", "additionalProperties": true },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": true,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "Property name or dotted path for the cell value."
              },
              "label": {
                "type": "string",
                "description": "Header text. Defaults to the field name."
              },
              "sortable": {
                "type": "boolean",
                "description": "Header click toggles display sort. Default true."
              },
              "align": {
                "type": "string",
                "enum": ["left", "center", "right"],
                "description": "Text alignment. Default left."
              },
              "fontWeight": {
                "description": "CSS font-weight for the header and cells.",
                "oneOf": [
                  { "type": "number", "minimum": 1, "maximum": 1000 },
                  {
                    "type": "string",
                    "minLength": 1
                  }
                ]
              }
            }
          }
        },
        "sort": {
          "type": "object",
          "additionalProperties": false,
          "description": "Initial display sort. Does not change the data array.",
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "direction": { "type": "string", "enum": ["asc", "desc"] }
          }
        }
      }
    }
  }
}
