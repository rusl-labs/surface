{
  "name": "@rusl-labs/surface-html",
  "version": "0.1.0",
  "description": "Composable HTML kit for @rusl-labs/surface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusl-labs/surface.git",
    "directory": "packages/html"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "schemas", "surface.css", "README.md", "DESIGN.md", "LICENSE"],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./surface.css": "./surface.css",
    "./schemas/default-kit.schema.json": "./schemas/default-kit.schema.json"
  },
  "dependencies": {
    "currency.js": "2.0.4",
    "libphonenumber-js": "^1.13.10"
  },
  "peerDependencies": {
    "@rusl-labs/surface": "^0.1.0",
    "react": ">=18.2.0 <20"
  }
}
