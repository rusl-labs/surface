{
  "name": "@rusl-labs/surface-ajv",
  "version": "0.1.0",
  "description": "Recommended AJV SurfaceValidator for @rusl-labs/surface (peer dependency on ajv).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rusl-labs/surface.git",
    "directory": "packages/ajv"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "prepack": "bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@rusl-labs/surface": "^0.1.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.0"
  }
}
