{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@rusl-labs/surface": ["./packages/core/src/index.ts"],
      "@rusl-labs/surface-ajv": ["./packages/ajv/src/index.ts"],
      "@rusl-labs/surface-html": ["./packages/html/src/index.tsx"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "verbatimModuleSyntax": true
  }
}
